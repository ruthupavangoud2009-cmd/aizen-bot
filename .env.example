# KYOKA 3.0 — copy to .env and fill in your own values.
# Never commit .env or share your Discord token/database password.

DISCORD_TOKEN=replace_with_your_discord_bot_token
CLIENT_ID=replace_with_your_discord_application_id
BOT_NAME=KYOKA 3.0
# Default prefix is +; ? and bot mentions are also supported concurrently.
BOT_PREFIX=+
SYNC_COMMANDS_ON_STARTUP=true
DEV_GUILD_ID=
INVITE_URL=
SUPPORT_URL=

# Optional Voice Welcome Companion Bot Token for concurrent independent voice greetings during music playback
VOICE_WELCOME_BOT_TOKEN=

# Required PostgreSQL/Supabase connection string.
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Security policy: the only privileged owner/developer ID is hardcoded in
# src/security/owner.py as 1505515188991033409. Do not configure extra IDs.
ENVIRONMENT=production
PORT=8080
ALLOW_OWNER_RESTART=false

# Optional integrations. Leave empty to disable them gracefully.
AIZEN_IMAGE_URL=
GEMINI_API_KEY=
GIPHY_API_KEY=
TENOR_API_KEY=
# GIPHY is tried first when configured; Tenor is the fallback provider.
GIF_PROVIDER=giphy

# Gemini model ID enabled for your API key (can be overridden in hosting settings)
GEMINI_MODEL=gemini-flash-lite-latest
AI_RESPONSE_TIMEOUT_SECONDS=15
AI_USER_COOLDOWN_SECONDS=3
AI_CHANNEL_COOLDOWN_SECONDS=2
AI_MAX_CONCURRENT_REQUESTS=5

# Comma-separated Discord User IDs authorized for restricted adult humor commands & aispecial
ADULT_COMMAND_ALLOWLIST=1505515188991033409

# Optional HTTP/HTTPS proxy to bypass datacenter IP rate limits (e.g., http://user:pass@host:port)
DISCORD_PROXY=
