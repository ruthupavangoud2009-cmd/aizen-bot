# KYOKA 3.0 — copy to .env and fill in your own values.
# Never commit .env or share your Discord token/database password.

DISCORD_TOKEN=replace_with_your_discord_bot_token
CLIENT_ID=replace_with_your_discord_application_id
BOT_NAME=KYOKA 3.0
# Preserves this project's existing default prefix. Change only if desired.
BOT_PREFIX=?
INVITE_URL=
SUPPORT_URL=

# Required PostgreSQL/Supabase connection string.
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Security policy: the only privileged owner/developer ID is hardcoded in
# src/security/owner.py as 1505515188991033409. Do not configure extra IDs.
ENVIRONMENT=production
PORT=8080
ALLOW_OWNER_RESTART=false

# Optional integrations. Leave empty to disable them gracefully.
AIZEN_IMAGE_URL=
GEMINI_API_KEY=
GIPHY_API_KEY=
TENOR_API_KEY=
# GIPHY is tried first when configured; Tenor is the fallback provider.
GIF_PROVIDER=giphy

# Gemini model ID enabled for your API key (can be overridden in hosting settings)
GEMINI_MODEL=gemini-3.5-flash-lite
